                    <div class="relative cursor-pointer group" onclick="showToast('Profile settings active')">
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=120" 
                             alt="User Avatar" 
                             class="w-10 h-10 rounded-full object-cover border-2 border-blue-500/60 shadow-md group-hover:border-blue-400 transition-all">
                        <span class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-emerald-500 border-2 border-slate-900 dark:border-slate-900 rounded-full"></span>
                    </div>
                    <div>
                        <p class="text-[11px] text-slate-400 font-medium">Good afternoon,</p>
                        <h2 class="text-sm font-bold text-slate-100 dark:text-white flex items-center gap-1.5">
                            Alex Morgan 
                            <span class="text-[10px] px-1.5 py-0.2 rounded-full bg-blue-500/20 text-blue-400 font-semibold border border-blue-500/30">PRO</span>
                        </h2>
                    </div>
                </div>

                <!-- Dark / Light Theme Switcher -->
                <button id="themeToggle" class="w-9 h-9 rounded-full bg-slate-800/80 border border-slate-700/60 flex items-center justify-center text-slate-300 hover:text-white btn-bounce shadow-sm">
                    <i id="themeIcon" class="fa-solid fa-moon text-xs text-blue-400"></i>
                </button>
            </header>

            <!-- Scrollable App Body -->
            <div class="flex-1 overflow-y-auto no-scrollbar px-5 pb-20 space-y-5">
                
                <!-- Main Balance Card & Multi-Currency Switcher -->
                <section class="hero-gradient rounded-3xl p-5 border border-white/10 shadow-2xl relative mt-1">
                    <div class="flex justify-between items-start mb-4">
                        <div>
                            <span class="text-[11px] uppercase tracking-wider font-semibold text-slate-400">Total Net Worth</span>
                            <div class="flex items-baseline gap-1 mt-0.5">
                                <span id="currencySymbol" class="text-xl font-bold text-blue-400">$</span>
                                <h1 id="balanceDisplay" class="text-3xl font-extrabold tracking-tight font-mono text-white transition-all">12,845.50</h1>
                            </div>
                        </div>

                        <!-- Multi-Currency Selector Tabs -->
                        <div class="flex bg-slate-900/80 backdrop-blur-md p-1 rounded-xl border border-white/10 shadow-inner">
                            <button onclick="switchCurrency('USD')" id="btn-USD" class="currency-btn px-2.5 py-1 text-xs font-bold rounded-lg bg-blue-600 text-white transition-all shadow-sm">USD</button>
                            <button onclick="switchCurrency('EUR')" id="btn-EUR" class="currency-btn px-2.5 py-1 text-xs font-bold rounded-lg text-slate-400 hover:text-white transition-all">EUR</button>
                            <button onclick="switchCurrency('GBP')" id="btn-GBP" class="currency-btn px-2.5 py-1 text-xs font-bold rounded-lg text-slate-400 hover:text-white transition-all">GBP</button>
                        </div>
                    </div>

                    <!-- Card Account Details -->
                    <div class="pt-3 border-t border-white/10 flex items-center justify-between text-xs text-slate-300">
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-credit-card text-blue-400"></i>
                            <span class="font-mono text-slate-300">•••• 8842</span>
                        </div>
                        <div class="flex items-center gap-1 text-emerald-400 font-semibold bg-emerald-500/10 px-2.5 py-0.5 rounded-full border border-emerald-500/20">
                            <i class="fa-solid fa-arrow-trend-up text-[10px]"></i>
                            <span>+6.4% this mo</span>
                        </div>
                    </div>
                </section>

                <!-- Quick Actions Grid -->
                <section class="grid grid-cols-4 gap-3">
                    <button onclick="openTransferSheet()" class="flex flex-col items-center gap-1.5 p-3 rounded-2xl bg-slate-800/50 border border-slate-700/50 hover:bg-slate-800 btn-bounce group">
                        <div class="w-11 h-11 rounded-2xl bg-blue-600/20 text-blue-400 flex items-center justify-center text-lg group-hover:bg-blue-600 group-hover:text-white transition-all shadow-sm">
                            <i class="fa-solid fa-paper-plane"></i>
                        </div>
                        <span class="text-[11px] font-semibold text-slate-300">Send</span>
                    </button>

                    <button onclick="showToast('Receive QR Code Ready')" class="flex flex-col items-center gap-1.5 p-3 rounded-2xl bg-slate-800/50 border border-slate-700/50 hover:bg-slate-800 btn-bounce group">
                        <div class="w-11 h-11 rounded-2xl bg-emerald-600/20 text-emerald-400 flex items-center justify-center text-lg group-hover:bg-emerald-600 group-hover:text-white transition-all shadow-sm">
                            <i class="fa-solid fa-qrcode"></i>
                        </div>
                        <span class="text-[11px] font-semibold text-slate-300">Receive</span>
                    </button>

                    <button onclick="showToast('Analytics Overview Opened')" class="flex flex-col items-center gap-1.5 p-3 rounded-2xl bg-slate-800/50 border border-slate-700/50 hover:bg-slate-800 btn-bounce group">
                        <div class="w-11 h-11 rounded-2xl bg-purple-600/20 text-purple-400 flex items-center justify-center text-lg group-hover:bg-purple-600 group-hover:text-white transition-all shadow-sm">
                            <i class="fa-solid fa-chart-pie"></i>
                        </div>
                        <span class="text-[11px] font-semibold text-slate-300">Analytics</span>
                    </button>

                    <button onclick="showToast('Cards Vault Active')" class="flex flex-col items-center gap-1.5 p-3 rounded-2xl bg-slate-800/50 border border-slate-700/50 hover:bg-slate-800 btn-bounce group">
                        <div class="w-11 h-11 rounded-2xl bg-amber-600/20 text-amber-400 flex items-center justify-center text-lg group-hover:bg-amber-600 group-hover:text-white transition-all shadow-sm">
                            <i class="fa-solid fa-wallet"></i>
                        </div>
                        <span class="text-[11px] font-semibold text-slate-300">Cards</span>
                    </button>
                </section>

                <!-- Recent Contacts Quick Transfer Row -->
                <section>
                    <div class="flex items-center justify-between mb-2.5">
                        <h3 class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Quick Pay Contacts</h3>
                        <span class="text-xs font-semibold text-blue-400 hover:underline cursor-pointer" onclick="showToast('All contacts loaded')">See All</span>
                    </div>
                    <div class="flex gap-3 overflow-x-auto no-scrollbar py-1">
                        <!-- Add contact button -->
                        <div class="flex flex-col items-center gap-1 min-w-[56px] cursor-pointer" onclick="showToast('Add Beneficiary Clicked')">
                            <div class="w-12 h-12 rounded-full border-2 border-dashed border-slate-700 flex items-center justify-center text-slate-400 hover:border-blue-500 hover:text-blue-500 btn-bounce">
                                <i class="fa-solid fa-plus text-xs"></i>
                            </div>
                            <span class="text-[10px] text-slate-400 font-medium truncate w-full text-center">Add</span>
                        </div>
                        <!-- Contact avatars -->
                        <div onclick="quickSelectContact('Sarah Jenkins', 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&q=80&w=120')" class="flex flex-col items-center gap-1 min-w-[56px] cursor-pointer group btn-bounce">
                            <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&q=80&w=120" class="w-12 h-12 rounded-full object-cover border-2 border-transparent group-hover:border-blue-500 transition-all shadow-sm">
                            <span class="text-[10px] text-slate-300 font-medium truncate w-14 text-center">Sarah</span>
                        </div>
                        <div onclick="quickSelectContact('David Chen', 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&q=80&w=120')" class="flex flex-col items-center gap-1 min-w-[56px] cursor-pointer group btn-bounce">
                            <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&q=80&w=120" class="w-12 h-12 rounded-full object-cover border-2 border-transparent group-hover:border-blue-500 transition-all shadow-sm">
                            <span class="text-[10px] text-slate-300 font-medium truncate w-14 text-center">David</span>
                        </div>
                        <div onclick="quickSelectContact('Elena Rostova', 'https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&q=80&w=120')" class="flex flex-col items-center gap-1 min-w-[56px] cursor-pointer group btn-bounce">
                            <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&q=80&w=120" class="w-12 h-12 rounded-full object-cover border-2 border-transparent group-hover:border-blue-500 transition-all shadow-sm">
                            <span class="text-[10px] text-slate-300 font-medium truncate w-14 text-center">Elena</span>
                        </div>
                        <div onclick="quickSelectContact('Marcus Vance', 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&q=80&w=120')" class="flex flex-col items-center gap-1 min-w-[56px] cursor-pointer group btn-bounce">
                            <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&q=80&w=120" class="w-12 h-12 rounded-full object-cover border-2 border-transparent group-hover:border-blue-500 transition-all shadow-sm">
                            <span class="text-[10px] text-slate-300 font-medium truncate w-14 text-center">Marcus</span>
                        </div>
                    </div>
                </section>

                <!-- Real-time Transaction Filtering Section -->
                <section class="space-y-3">
                    <div class="flex items-center justify-between">
                        <h3 class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Activity</h3>
                        <!-- Filter Tabs -->
                        <div class="flex bg-slate-800/80 p-0.5 rounded-lg border border-slate-700/60 text-[11px]">
                            <button onclick="filterTransactions('all')" id="tab-all" class="tx-tab px-2.5 py-0.5 rounded-md bg-blue-600 text-white font-semibold transition-all">All</button>
                            <button onclick="filterTransactions('income')" id="tab-income" class="tx-tab px-2.5 py-0.5 rounded-md text-slate-400 hover:text-white transition-all">Income</button>
                            <button onclick="filterTransactions('expense')" id="tab-expense" class="tx-tab px-2.5 py-0.5 rounded-md text-slate-400 hover:text-white transition-all">Expenses</button>
                        </div>
                    </div>

                    <!-- Dynamic Transaction Items -->
                    <div id="transactionList" class="space-y-2.5">
                        <!-- Content rendered via JavaScript -->
                    </div>
                </section>
            </div>

            <!-- Bottom Navigation Bar -->
            <nav class="absolute bottom-0 left-0 right-0 h-16 bg-slate-900/95 dark:bg-slate-900/95 backdrop-blur-xl border-t border-slate-800/80 px-6 flex items-center justify-between z-20">
                <button class="flex flex-col items-center gap-1 text-blue-500">
                    <i class="fa-solid fa-house text-base"></i>
                    <span class="text-[10px] font-bold">Home</span>
                </button>
                <button class="flex flex-col items-center gap-1 text-slate-400 hover:text-slate-200 transition-colors" onclick="showToast('Vault view enabled')">
                    <i class="fa-solid fa-vault text-base"></i>
                    <span class="text-[10px] font-medium">Vault</span>
                </button>
                <button onclick="openTransferSheet()" class="w-12 h-12 rounded-full bg-blue-600 hover:bg-blue-500 text-white flex items-center justify-center -mt-6 shadow-lg shadow-blue-600/40 border-4 border-slate-900 btn-bounce">
                    <i class="fa-solid fa-arrow-up-right-dots text-base"></i>
                </button>
                <button class="flex flex-col items-center gap-1 text-slate-400 hover:text-slate-200 transition-colors" onclick="showToast('Analytics view enabled')">
                    <i class="fa-solid fa-chart-simple text-base"></i>
                    <span class="text-[10px] font-medium">Stats</span>
                </button>
                <button class="flex flex-col items-center gap-1 text-slate-400 hover:text-slate-200 transition-colors" onclick="showToast('Settings view enabled')">
                    <i class="fa-solid fa-gear text-base"></i>
                    <span class="text-[10px] font-medium">Settings</span>
                </button>
            </nav>

            <!-- 1-Tap Quick Transfer Slide-Up Bottom Sheet Modal -->
            <div id="transferSheet" class="absolute inset-0 bg-slate-950/80 backdrop-blur-sm z-40 hidden flex-col justify-end transition-opacity opacity-0">
                <div id="sheetContent" class="w-full bg-slate-900 border-t border-slate-800 rounded-t-[32px] p-5 pb-8 sheet-transition transform translate-y-full shadow-2xl space-y-4">
                    
                    <!-- Drag Handle Indicator -->
                    <div class="w-12 h-1 bg-slate-700 rounded-full mx-auto mb-1"></div>

                    <!-- Modal Header -->
                    <div class="flex items-center justify-between">
                        <h3 class="text-base font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-bolt text-amber-400"></i>
                            1-Tap Quick Transfer
                        </h3>
                        <button onclick="closeTransferSheet()" class="w-8 h-8 rounded-full bg-slate-800 text-slate-400 hover:text-white flex items-center justify-center btn-bounce">
                            <i class="fa-solid fa-xmark text-sm"></i>
                        </button>
                    </div>

                    <!-- Selected Recipient Card -->
                    <div class="p-3 bg-slate-800/60 rounded-2xl border border-slate-700/50 flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <img id="selectedContactImg" src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&q=80&w=120" class="w-10 h-10 rounded-full object-cover border border-blue-500/40">
                            <div>
                                <p class="text-[10px] uppercase font-bold text-slate-400">Recipient</p>
                                <p id="selectedContactName" class="text-xs font-bold text-white">Sarah Jenkins</p>
                            </div>
                        </div>
                        <span class="text-xs text-blue-400 font-semibold cursor-pointer hover:underline" onclick="showToast('Select another contact')">Change</span>
                    </div>

                    <!-- Preset Amount Buttons -->
                    <div class="flex items-center justify-between gap-2">
                        <button onclick="setPresetAmount(50)" class="flex-1 py-1.5 rounded-xl bg-slate-800/80 border border-slate-700/60 text-xs font-bold text-slate-300 hover:text-white hover:border-blue-500 btn-bounce">$50</button>
                        <button onclick="setPresetAmount(100)" class="flex-1 py-1.5 rounded-xl bg-slate-800/80 border border-slate-700/60 text-xs font-bold text-slate-300 hover:text-white hover:border-blue-500 btn-bounce">$100</button>
                        <button onclick="setPresetAmount(250)" class="flex-1 py-1.5 rounded-xl bg-slate-800/80 border border-slate-700/60 text-xs font-bold text-slate-300 hover:text-white hover:border-blue-500 btn-bounce">$250</button>
                    </div>

                    <!-- Transfer Amount Keypad Input Display -->
                    <div class="text-center py-1">
                        <p class="text-[11px] text-slate-400 mb-1">Transfer Amount</p>
                        <div class="text-3xl font-extrabold font-mono text-white flex items-center justify-center gap-1">
                            <span id="sheetCurrencySymbol">$</span>
                            <span id="transferAmount">0</span>
                        </div>
                    </div>

                    <!-- Keypad Input Grid -->
                    <div class="grid grid-cols-3 gap-2 px-2">
                        <button onclick="keypadPress('1')" class="py-2.5 rounded-xl bg-slate-800/80 hover:bg-slate-700 font-bold text-sm text-white btn-bounce">1</button>
                        <button onclick="keypadPress('2')" class="py-2.5 rounded-xl bg-slate-800/80 hover:bg-slate-700 font-bold text-sm text-white btn-bounce">2</button>
                        <button onclick="keypadPress('3')" class="py-2.5 rounded-xl bg-slate-800/80 hover:bg-slate-700 font-bold text-sm text-white btn-bounce">3</button>
                        <button onclick="keypadPress('4')" class="py-2.5 rounded-xl bg-slate-800/80 hover:bg-slate-700 font-bold text-sm text-white btn-bounce">4</button>
                        <button onclick="keypadPress('5')" class="py-2.5 rounded-xl bg-slate-800/80 hover:bg-slate-700 font-bold text-sm text-white btn-bounce">5</button>
                        <button onclick="keypadPress('6')" class="py-2.5 rounded-xl bg-slate-800/80 hover:bg-slate-700 font-bold text-sm text-white btn-bounce">6</button>
                        <button onclick="keypadPress('7')" class="py-2.5 rounded-xl bg-slate-800/80 hover:bg-slate-700 font-bold text-sm text-white btn-bounce">7</button>
                        <button onclick="keypadPress('8')" class="py-2.5 rounded-xl bg-slate-800/80 hover:bg-slate-700 font-bold text-sm text-white btn-bounce">8</button>
                        <button onclick="keypadPress('9')" class="py-2.5 rounded-xl bg-slate-800/80 hover:bg-slate-700 font-bold text-sm text-white btn-bounce">9</button>
                        <button onclick="keypadPress('.')" class="py-2.5 rounded-xl bg-slate-800/80 hover:bg-slate-700 font-bold text-sm text-white btn-bounce">.</button>
                        <button onclick="keypadPress('0')" class="py-2.5 rounded-xl bg-slate-800/80 hover:bg-slate-700 font-bold text-sm text-white btn-bounce">0</button>
                        <button onclick="keypadPress('DEL')" class="py-2.5 rounded-xl bg-slate-800/80 hover:bg-slate-700 font-bold text-sm text-rose-400 btn-bounce">
                            <i class="fa-solid fa-delete-left"></i>
                        </button>
                    </div>

                    <!-- Confirm Action Button -->
                    <button id="confirmSendBtn" onclick="executeTransfer()" class="w-full py-3.5 rounded-2xl bg-gradient-to-r from-blue-600 to-emerald-500 hover:from-blue-500 hover:to-emerald-400 font-bold text-sm text-white shadow-lg shadow-blue-600/30 btn-bounce flex items-center justify-center gap-2">
                        <span>Confirm Transfer</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </div>
            </div>

            <!-- Animated Transfer Success Modal -->
            <div id="successModal" class="absolute inset-0 bg-slate-950/90 backdrop-blur-md z-50 hidden flex-col items-center justify-center p-6 text-center space-y-5">
                <!-- SVG Checkmark Animation -->
                <div class="w-20 h-20 relative flex items-center justify-center">
                    <svg class="w-20 h-20" viewBox="0 0 52 52">
                        <circle class="success-circle" cx="26" cy="26" r="23" fill="none"/>
                        <path class="success-check" fill="none" stroke="#10B981" stroke-width="4" d="M14.1 27.2l7.1 7.2 16.7-16.8"/>
                    </svg>
                </div>

                <div>
                    <h3 class="text-xl font-extrabold text-white">Transfer Completed!</h3>
                    <p class="text-xs text-slate-400 mt-1">Processed instantly via Aura Quantum Ledger.</p>
                </div>

                <!-- Receipt Card -->
                <div class="w-full bg-slate-800/60 p-4 rounded-2xl border border-slate-700/60 text-left space-y-2 text-xs">
                    <div class="flex justify-between"><span class="text-slate-400">Recipient</span><span id="receiptName" class="font-bold text-white">Sarah Jenkins</span></div>
                    <div class="flex justify-between"><span class="text-slate-400">Amount Sent</span><span id="receiptAmount" class="font-bold text-emerald-400 font-mono">$0.00</span></div>
                    <div class="flex justify-between"><span class="text-slate-400">Reference</span><span class="font-mono text-slate-300">AUR-2026-904X</span></div>
                </div>

                <button onclick="closeSuccessModal()" class="w-full py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold btn-bounce shadow-lg shadow-blue-600/30">Done</button>
            </div>

            <!-- Toast Notification Box -->
            <div id="toast" class="absolute top-12 left-1/2 -translate-x-1/2 bg-slate-800/90 text-white text-xs px-4 py-2 rounded-full border border-slate-700 shadow-2xl opacity-0 pointer-events-none transition-all duration-300 z-50 flex items-center gap-2">
                <i class="fa-solid fa-circle-info text-blue-400"></i>
                <span id="toastMsg">Notification</span>
            </div>

        </div>
    </div>

    <script>
        // Currency & Exchange Rate State
        const currencyData = {
            USD: { symbol: '$', balance: 12845.50, rate: 1.0 },
            EUR: { symbol: '€', balance: 11420.10, rate: 0.91 },
            GBP: { symbol: '£', balance: 9850.00, rate: 0.78 }
        };

        let currentCurrency = 'USD';
        let currentFilter = 'all';
        let inputAmountStr = '0';

        // Transaction Ledger Mock Data
        const transactions = [
            { id: 1, name: 'Figma Enterprise', category: 'Design Software', type: 'expense', amount: 45.00, date: 'Today, 2:15 PM', icon: 'fa-figma', color: 'bg-purple-500/20 text-purple-400' },
            { id: 2, name: 'Stripe Payout', category: 'Design Retainer', type: 'income', amount: 2400.00, date: 'Yesterday', icon: 'fa-stripe-s', color: 'bg-emerald-500/20 text-emerald-400' },
            { id: 3, name: 'Apple Store', category: 'Hardware Upgrade', type: 'expense', amount: 1299.00, date: '21 Sep', icon: 'fa-apple', color: 'bg-slate-500/20 text-slate-300' },
            { id: 4, name: 'Spotify Premium', category: 'Subscription', type: 'expense', amount: 14.99, date: '19 Sep', icon: 'fa-spotify', color: 'bg-green-500/20 text-green-400' },
            { id: 5, name: 'Angel Dividend', category: 'Investment Income', type: 'income', amount: 310.50, date: '18 Sep', icon: 'fa-arrow-trend-up', color: 'bg-blue-500/20 text-blue-400' }
        ];

        // Currency Switching Function
        function switchCurrency(code) {
            currentCurrency = code;
            const data = currencyData[code];

            // Update tab UI buttons
            document.querySelectorAll('.currency-btn').forEach(btn => {
                btn.className = 'currency-btn px-2.5 py-1 text-xs font-bold rounded-lg text-slate-400 hover:text-white transition-all';
            });
            const activeBtn = document.getElementById(`btn-${code}`);
            if (activeBtn) {
                activeBtn.className = 'currency-btn px-2.5 py-1 text-xs font-bold rounded-lg bg-blue-600 text-white transition-all shadow-sm';
            }

            // Update Symbol & Animate Balance
            document.getElementById('currencySymbol').innerText = data.symbol;
            document.getElementById('sheetCurrencySymbol').innerText = data.symbol;
            animateCounter('balanceDisplay', data.balance);

            renderTransactions();
            showToast(`Currency switched to ${code}`);
        }

        // Counter Animation for Currency Changes
        function animateCounter(elementId, targetVal) {
            const el = document.getElementById(elementId);
            const startVal = parseFloat(el.innerText.replace(/,/g, '')) || 0;
            const duration = 400;
            const startTime = performance.now();

            function update(now) {
                const elapsed = now - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const currentVal = startVal + (targetVal - startVal) * progress;
                el.innerText = currentVal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

                if (progress < 1) {
                    requestAnimationFrame(update);
                }
            }
            requestAnimationFrame(update);
        }

        // Transaction List Dynamic Rendering
        function renderTransactions() {
            const container = document.getElementById('transactionList');
            const filtered = transactions.filter(t => currentFilter === 'all' || t.type === currentFilter);
            const curr = currencyData[currentCurrency];

            if (filtered.length === 0) {
                container.innerHTML = `<p class="text-xs text-slate-500 text-center py-4">No transactions found</p>`;
                return;
            }

            container.innerHTML = filtered.map(t => {
                const convertedAmount = (t.amount * curr.rate).toFixed(2);
                const isIncome = t.type === 'income';
                const sign = isIncome ? '+' : '-';
                const amountColor = isIncome ? 'text-emerald-400' : 'text-slate-200';

                return `
                    <div class="p-3 bg-slate-800/40 dark:bg-slate-800/50 hover:bg-slate-800 rounded-2xl border border-slate-700/40 transition-all flex items-center justify-between cursor-pointer btn-bounce" onclick="showToast('${t.name}: ${curr.symbol}${convertedAmount}')">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl ${t.color} flex items-center justify-center text-sm shadow-sm">
                                <i class="fa-brands ${t.icon} fa-solid"></i>
                            </div>
                            <div>
                                <p class="text-xs font-bold text-slate-100 dark:text-slate-100">${t.name}</p>
                                <p class="text-[10px] text-slate-400">${t.category} • ${t.date}</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="text-xs font-extrabold font-mono ${amountColor}">${sign}${curr.symbol}${convertedAmount}</p>
                            <span class="text-[9px] px-1.5 py-0.2 rounded bg-slate-700/50 text-slate-400">Completed</span>
                        </div>
                    </div>
                `;
            }).join('');
        }

        // Filter Transactions Tab Switcher
        function filterTransactions(type) {
            currentFilter = type;
            document.querySelectorAll('.tx-tab').forEach(btn => {
                btn.className = 'tx-tab px-2.5 py-0.5 rounded-md text-slate-400 hover:text-white transition-all';
            });
            const activeTab = document.getElementById(`tab-${type}`);
            if (activeTab) {
                activeTab.className = 'tx-tab px-2.5 py-0.5 rounded-md bg-blue-600 text-white font-semibold transition-all';
            }
            renderTransactions();
        }

        // Bottom Sheet Modal Controllers
        function openTransferSheet() {
            const sheet = document.getElementById('transferSheet');
            const content = document.getElementById('sheetContent');
            sheet.classList.remove('hidden');
            sheet.classList.add('flex');
            setTimeout(() => {
                sheet.classList.remove('opacity-0');
                content.classList.remove('translate-y-full');
            }, 10);
        }

        function closeTransferSheet() {
            const sheet = document.getElementById('transferSheet');
            const content = document.getElementById('sheetContent');
            content.classList.add('translate-y-full');
            sheet.classList.add('opacity-0');
            setTimeout(() => {
                sheet.classList.add('hidden');
                sheet.classList.remove('flex');
                inputAmountStr = '0';
                updateTransferDisplay();
            }, 300);
        }

        function quickSelectContact(name, img) {
            document.getElementById('selectedContactName').innerText = name;
            document.getElementById('selectedContactImg').src = img;
            openTransferSheet();
        }

        function setPresetAmount(amt) {
            inputAmountStr = amt.toString();
            updateTransferDisplay();
            showToast(`Preset $${amt} selected`);
        }

        // Keypad Logic
        function keypadPress(val) {
            if (val === 'DEL') {
                inputAmountStr = inputAmountStr.slice(0, -1);
                if (inputAmountStr === '' || inputAmountStr === '0') inputAmountStr = '0';
            } else if (val === '.') {
                if (!inputAmountStr.includes('.')) inputAmountStr += '.';
            } else {
                if (inputAmountStr === '0') {
                    inputAmountStr = val;
                } else {
                    if (inputAmountStr.length < 7) inputAmountStr += val;
                }
            }
            updateTransferDisplay();
        }

        function updateTransferDisplay() {
            document.getElementById('transferAmount').innerText = inputAmountStr;
        }

        // Confirm & Execute Quick Transfer
        function executeTransfer() {
            const num = parseFloat(inputAmountStr);
            if (isNaN(num) || num <= 0) {
                showToast('Please enter a valid amount');
                return;
            }

            const curr = currencyData[currentCurrency];
            if (num > curr.balance) {
                showToast('Insufficient wallet balance!');
                return;
            }

            // Deduct from Balance
            curr.balance -= num;
            document.getElementById('balanceDisplay').innerText = curr.balance.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            // Add new transaction entry
            const recipient = document.getElementById('selectedContactName').innerText;
            transactions.unshift({
                id: Date.now(),
                name: recipient,
                category: 'Quick Transfer',
                type: 'expense',
                amount: num / curr.rate,
                date: 'Just now',
                icon: 'fa-paper-plane',
                color: 'bg-blue-500/20 text-blue-400'
            });

            closeTransferSheet();
            renderTransactions();

            // Trigger Success Modal
            setTimeout(() => {
                document.getElementById('receiptName').innerText = recipient;
                document.getElementById('receiptAmount').innerText = `${curr.symbol}${num.toFixed(2)}`;
                document.getElementById('successModal').classList.remove('hidden');
                document.getElementById('successModal').classList.add('flex');
            }, 350);
        }

        function closeSuccessModal() {
            document.getElementById('successModal').classList.add('hidden');
            document.getElementById('successModal').classList.remove('flex');
        }

        // Toast Feedback Popup
        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMsg').innerText = msg;
            toast.classList.remove('opacity-0', 'pointer-events-none');
            setTimeout(() => {
                toast.classList.add('opacity-0', 'pointer-events-none');
            }, 2200);
        }

        // Theme Toggle
        const themeBtn = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        const appContainer = document.getElementById('appContainer');

        themeBtn.addEventListener('click', () => {
            if (appContainer.classList.contains('dark')) {
                appContainer.classList.remove('dark');
                appContainer.classList.remove('bg-slate-900', 'text-slate-100');
                appContainer.classList.add('bg-slate-100', 'text-slate-900');
                themeIcon.className = 'fa-solid fa-sun text-xs text-amber-400';
                showToast('Light mode active');
            } else {
                appContainer.classList.add('dark');
                appContainer.classList.remove('bg-slate-100', 'text-slate-900');
                appContainer.classList.add('bg-slate-900', 'text-slate-100');
                themeIcon.className = 'fa-solid fa-moon text-xs text-blue-400';
                showToast('Dark mode active');
            }
        });

        // Initialize on load
        window.onload = function() {
            renderTransactions();
        };
    </script>
</body>
</html>
