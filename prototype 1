<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aura Mobile Banking & Design System Demo</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        aura: {
                            navy: '#0F172A',
                            blue: '#3B82F6',
                            'blue-hover': '#2563EB',
                            emerald: '#10B981',
                            card: 'rgba(30, 41, 59, 0.7)',
                            border: 'rgba(255, 255, 255, 0.1)',
                            'light-bg': '#F8FAFC',
                            'light-card': '#FFFFFF',
                            'light-border': '#E2E8F0'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace']
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
            -webkit-tap-highlight-color: transparent;
            user-select: none;
        }

        /* Frosted Glassmorphism Styling */
        .glass-card {
            background: rgba(30, 41, 59, 0.65);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .light .glass-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(0, 0, 0, 0.08);
        }

        .hero-gradient {
            background: linear-gradient(135deg, #1E293B 0%, #0F172A 100%);
            position: relative;
            overflow: hidden;
        }

        .hero-gradient::before {
            content: '';
            position: absolute;
            top: -40%;
            left: -40%;
            width: 180%;
            height: 180%;
            background: radial-gradient(circle, rgba(59, 130, 246, 0.3) 0%, rgba(16, 185, 129, 0.15) 35%, transparent 70%);
            pointer-events: none;
            animation: pulse-glow 8s infinite alternate ease-in-out;
        }

        @keyframes pulse-glow {
            0% { transform: scale(0.9) translate(-10px, -10px); }
            100% { transform: scale(1.1) translate(10px, 10px); }
        }

        /* Custom Scrollbar for Phone Container */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        /* Micro-interactions & Tactile Bounce */
        .btn-bounce {
            transition: transform 0.15s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.2s ease, box-shadow 0.2s ease;
        }
        .btn-bounce:active {
            transform: scale(0.93);
        }

        /* Modal Slide Transitions */
        .sheet-transition {
            transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
        }

        /* Animated Success Checkmark Ring */
        .success-circle {
            stroke-dasharray: 166;
            stroke-dashoffset: 166;
            stroke-width: 3;
            stroke-miterlimit: 10;
            stroke: #10B981;
            fill: none;
            animation: stroke 0.6s cubic-bezier(0.65, 0, 0.45, 1) forwards;
        }

        .success-check {
            transform-origin: 50% 50%;
            stroke-dasharray: 48;
            stroke-dashoffset: 48;
            animation: stroke 0.3s cubic-bezier(0.65, 0, 0.45, 1) 0.6s forwards;
        }

        @keyframes stroke {
            100% { stroke-dashoffset: 0; }
        }

        /* Shimmer Loading Effect */
        .shimmer {
            background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.08) 50%, rgba(255,255,255,0) 100%);
            background-size: 200% 100%;
            animation: shimmer 1.5s infinite;
        }
        @keyframes shimmer {
            0% { background-position: -200% 0; }
            100% { background-position: 200% 0; }
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex items-center justify-center p-2 sm:p-6 overflow-hidden">

    <!-- Mobile Outer Device Frame -->
    <div class="w-full max-w-[420px] h-[860px] max-h-[96vh] bg-slate-950 rounded-[50px] p-3 shadow-2xl border-[5px] border-slate-800 flex flex-col relative overflow-hidden ring-1 ring-white/10">
        
        <!-- Top Speaker & Dynamic Notch/Island -->
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-32 h-6 bg-slate-950 rounded-b-2xl z-50 flex items-center justify-center gap-2">
            <div class="w-10 h-1 bg-slate-800 rounded-full"></div>
            <div class="w-2.5 h-2.5 bg-slate-900 border border-slate-800 rounded-full flex items-center justify-center">
                <div class="w-1 h-1 bg-blue-500/60 rounded-full"></div>
            </div>
        </div>

        <!-- Phone App Screen Container -->
        <div id="appContainer" class="dark w-full h-full bg-slate-900 text-slate-100 rounded-[38px] flex flex-col overflow-hidden relative border border-slate-800/80 transition-colors duration-300">
            
            <!-- Header Status & Profile Bar -->
            <header class="pt-7 px-5 pb-3 flex items-center justify-between z-10">
