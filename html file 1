    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        aura: {
                            navy: '#0F172A',
                            blue: '#3B82F6',
                            'blue-hover': '#2563EB',
                            emerald: '#10B981',
                            card: 'rgba(30, 41, 59, 0.7)',
                            border: 'rgba(255, 255, 255, 0.1)',
                            'light-bg': '#F8FAFC',
                            'light-card': '#FFFFFF',
                            'light-border': '#E2E8F0'
